cabal-version:   3.14
name:            contextlm
version:         0.1.0.0
license:         NONE
author:          Adithya Kumar
maintainer:      functional.binder@gmail.com
build-type:      Simple
extra-doc-files: CHANGELOG.md

common warnings
    ghc-options: -Wall

executable contextlm
    import:           warnings
    main-is:          Main.hs
    other-modules:    Types, Cli, FileSystem
    build-depends:    base
                    , streamly-core
                    , streamly-process
                    , directory
                    , temporary
                    , filepath
                    , Glob
    hs-source-dirs:   app
    default-language: Haskell2010
